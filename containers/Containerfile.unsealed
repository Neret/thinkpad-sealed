# syntax=docker/dockerfile:1
ARG BASE=ghcr.io/neret/fedora-bootc-sealed-os:latest

FROM ${BASE} AS base

FROM quay.io/fedora/fedora-bootc:45 AS sign
RUN dnf install -y sbsigntools && dnf clean all
RUN --mount=type=bind,from=base,target=/target \
    --mount=type=secret,id=key \
    --mount=type=secret,id=cert <<'EOF'
set -euo pipefail
mkdir -p /out
sbsign --key /run/secrets/key --cert /run/secrets/cert \
  --output /out/systemd-bootx64.efi \
  /target/usr/lib/systemd/boot/efi/systemd-bootx64.efi
EOF

FROM base AS builder
COPY --from=sign /out/systemd-bootx64.efi /usr/lib/systemd/boot/efi/systemd-bootx64.efi

RUN if rpm -q bootupd >/dev/null 2>&1; then \
      dnf remove -y bootupd; \
    fi

RUN if rpm -q dnf5 >/dev/null 2>&1; then \
      dnf remove -y --setopt=protected_packages= dnf5; \
    fi

RUN rm -rf \
      /var/cache/dnf \
      /var/cache/libdnf5 \
      /var/cache/ldconfig/aux-cache \
      /var/log/dnf5.log \
      /var/log/* \
      /run/dnf \
      /run/selinux-policy \
      /var/lib/dnf/repos \
      /etc/selinux/targeted/previous && \
    find /run /tmp -mindepth 1 -delete 2>/dev/null || true

FROM scratch AS unsealed
COPY --from=builder / /
LABEL containers.bootc=1
LABEL ostree.bootable=1
LABEL org.opencontainers.image.title="fedora-bootc-sealed-os-unsealed"
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
