# syntax=docker/dockerfile:1
ARG BASE=ghcr.io/neret/fedora-bootc-sealed-os:latest

FROM ${BASE} AS builder

RUN if rpm -q bootupd >/dev/null 2>&1; then \
      dnf remove -y bootupd; \
    fi

RUN if rpm -q dnf5 >/dev/null 2>&1; then \
      dnf remove -y dnf5; \
    fi

RUN rm -rf \
      /var/cache/dnf \
      /var/cache/libdnf5 \
      /var/cache/ldconfig/aux-cache \
      /var/log/dnf5.log \
      /var/log/* \
      /run/dnf \
      /run/selinux-policy \
      /var/lib/dnf/repos \
      /etc/selinux/targeted/previous && \
    find /run /tmp -mindepth 1 -delete 2>/dev/null || true

FROM scratch AS unsealed
COPY --from=builder / /
LABEL containers.bootc=1
LABEL ostree.bootable=1
LABEL org.opencontainers.image.title="fedora-bootc-sealed-os-unsealed"
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
