ARG BASE=ghcr.io/neret/fedora-bootc-sealed-os:latest
ARG SIGNER=quay.io/fedora/fedora-bootc:45

FROM ${BASE} AS base

FROM ${SIGNER} AS sign
RUN dnf install -y sbsigntools && dnf clean all
RUN --mount=type=bind,from=base,target=/target \
    --mount=type=secret,id=key \
    --mount=type=secret,id=cert \
    bash -s <<'EOF'
set -euo pipefail
src=/target/usr/lib/systemd/boot/efi/systemd-bootx64.efi
test -f "$src"
mkdir -p /out
sbsign --key /run/secrets/key --cert /run/secrets/cert \
  --output /out/systemd-bootx64.efi "$src"
sbverify --cert /run/secrets/cert /out/systemd-bootx64.efi
EOF

FROM base AS builder
COPY --from=sign /out/systemd-bootx64.efi /usr/lib/systemd/boot/efi/systemd-bootx64.efi

RUN if rpm -q bootupd >/dev/null 2>&1; then \
      dnf remove -y bootupd; \
    fi

RUN if rpm -q dnf5 >/dev/null 2>&1; then \
      dnf remove -y --setopt=protected_packages= dnf5; \
    fi

RUN rm -rf \
      /var/cache/dnf \
      /var/cache/libdnf5 \
      /var/cache/ldconfig/aux-cache \
      /var/log/dnf5.log \
      /var/log/* \
      /run/dnf \
      /run/selinux-policy \
      /var/lib/dnf/repos \
      /etc/selinux/targeted/previous && \
    find /run /tmp -mindepth 1 -delete 2>/dev/null || true

RUN bootc container lint --fatal-warnings

FROM builder AS kernel-src
RUN mkdir /kernel && \
    bootc container split-kernel-and-rootfs --rootfs / --output /kernel

FROM scratch AS kernel
COPY --from=kernel-src /kernel /kernel

FROM builder AS strip
RUN mkdir /tmp/k && \
    bootc container split-kernel-and-rootfs --rootfs / --output /tmp/k && \
    rm -rf /tmp/k

FROM scratch AS unsealed
COPY --from=strip / /
LABEL containers.bootc=1
LABEL ostree.bootable=1
LABEL org.opencontainers.image.title="fedora-bootc-sealed-os-unsealed"
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
