[Unit]
Description=Allinea systemd-boot, shim e MokManager firmati dell'immagine con la ESP
ConditionPathExists=/sys/firmware/efi
ConditionPathExists=/usr/lib/systemd/boot/efi/systemd-bootx64.efi
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sealed-bootloader-sync
ExecStart=/usr/libexec/sealed-shim-sync --auto

[Install]
WantedBy=multi-user.target
