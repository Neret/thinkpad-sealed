[Unit]
Description=Allinea systemd-boot firmato dell'immagine con la ESP (e controlla shim)
ConditionPathExists=/sys/firmware/efi
ConditionPathExists=/usr/lib/systemd/boot/efi/systemd-bootx64.efi
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sealed-bootloader-sync
# solo controllo e avviso su shim/MokManager; il '-' ignora eventuali errori
ExecStart=-/usr/libexec/sealed-shim-sync

[Install]
WantedBy=multi-user.target
