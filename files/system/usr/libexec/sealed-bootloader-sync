#!/usr/bin/bash
# Allinea il systemd-boot firmato dell'immagine con le due copie sulla ESP
# (EFI/systemd/systemd-bootx64.efi e EFI/BOOT/grubx64.efi, quello che carica shim).
# Va in: files/system/usr/libexec/sealed-bootloader-sync (eseguibile)
#
# La verifica della firma e' OBBLIGATORIA: senza sbverify, senza certificato
# o con firma non valida lo script esce con errore e non tocca la ESP.
# Richiede: pacchetto sbsigntools e /usr/share/sealed/MOK.crt (PEM, pubblico) nell'immagine.
set -euo pipefail

SRC=/usr/lib/systemd/boot/efi/systemd-bootx64.efi
ESP_DEV="${ESP_DEV:-/dev/disk/by-partlabel/ESP}"
CERT=/usr/share/sealed/MOK.crt

die() { echo "sealed-bootloader-sync: $*" >&2; exit 1; }

[[ -s "$SRC" ]]  || die "sorgente mancante: $SRC"
[[ -b "$ESP_DEV" ]] || die "ESP non trovata: $ESP_DEV"

# --- verifica firma obbligatoria, PRIMA di montare o scrivere qualsiasi cosa ---
command -v sbverify >/dev/null 2>&1 \
  || die "sbverify non trovato (aggiungi sbsigntools a packages.yml): non tocco la ESP"
[[ -s "$CERT" ]] \
  || die "certificato $CERT mancante (aggiungilo in files/system/usr/share/sealed/): non tocco la ESP"
sbverify --cert "$CERT" "$SRC" >/dev/null 2>&1 \
  || die "firma di $SRC NON valida con $CERT: non tocco la ESP"
echo "firma valida: $SRC"

MNT="$(mktemp -d /run/sealed-esp.XXXXXX)"
cleanup() {
  mountpoint -q "$MNT" && umount "$MNT" || true
  rmdir "$MNT" 2>/dev/null || true
}
trap cleanup EXIT

mount -o rw,nosuid,nodev,noexec "$ESP_DEV" "$MNT"
mkdir -p "$MNT/EFI/systemd" "$MNT/EFI/BOOT"

# Pulizia: residui di copie interrotte (*.new) e vecchi backup con nomi diversi da .prev.
# Resta sempre e solo UN backup: EFI/systemd/systemd-bootx64.efi.prev
rm -f -- "$MNT"/EFI/systemd/*.new "$MNT"/EFI/BOOT/*.new
for f in "$MNT"/EFI/systemd/systemd-bootx64.efi.*; do
  [[ -e "$f" ]] || continue
  [[ "$f" == "$MNT/EFI/systemd/systemd-bootx64.efi.prev" ]] && continue
  echo "rimuovo vecchio residuo: ${f#$MNT/}"
  rm -f -- "$f"
done

replace() {
  local dst="$1" tmp="$1.new"
  if [[ -f "$dst" ]] && cmp -s "$SRC" "$dst"; then
    echo "gia' allineato: ${dst#$MNT/}"
    return 0
  fi
  cp -- "$SRC" "$tmp"
  sync -f "$tmp"
  # la copia deve essere identica alla sorgente verificata E avere firma valida
  cmp -s "$SRC" "$tmp" || { rm -f "$tmp"; die "copia corrotta: $dst"; }
  sbverify --cert "$CERT" "$tmp" >/dev/null 2>&1 \
    || { rm -f "$tmp"; die "firma non valida sulla copia: $dst"; }
  mv -f -- "$tmp" "$dst"
  echo "aggiornato: ${dst#$MNT/}"
}

# backup del vecchio binario (non e' in un percorso di boot: serve solo per recupero da live USB)
if [[ -f "$MNT/EFI/systemd/systemd-bootx64.efi" ]] \
   && ! cmp -s "$SRC" "$MNT/EFI/systemd/systemd-bootx64.efi"; then
  cp -f -- "$MNT/EFI/systemd/systemd-bootx64.efi" "$MNT/EFI/systemd/systemd-bootx64.efi.prev"
fi

replace "$MNT/EFI/systemd/systemd-bootx64.efi"
replace "$MNT/EFI/BOOT/grubx64.efi"
sync
