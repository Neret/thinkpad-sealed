#!/usr/bin/bash
set -uo pipefail

LIBEXEC="${SEALED_LIBEXEC:-/usr/libexec}"

# shellcheck source=/dev/null
source "$LIBEXEC/sealed-sync-lib"

DRY_RUN=0
WANT=()

for a in "$@"; do
    case "$a" in
        --dry-run)
            DRY_RUN=1
            ;;
        -h|--help)
            sed -n '5,20p' "$0"
            exit 0
            ;;
        -*)
            die "unknown option: $a"
            ;;
        *)
            WANT+=("$a")
            ;;
    esac
done

export DRY_RUN

shopt -s nullglob
SCRIPTS=("$LIBEXEC"/sealed-sync.d/[0-9][0-9]-*)

(( ${#SCRIPTS[@]} > 0 )) || die "no components found in $LIBEXEC/sealed-sync.d"

name_of() {
    local n="${1##*/}"
    echo "${n#[0-9][0-9]-}"
}

for w in "${WANT[@]}"; do
    found=0

    for s in "${SCRIPTS[@]}"; do
        [[ "$(name_of "$s")" == "$w" ]] && found=1
    done

    (( found )) || die "unknown component: $w"
done

RUN=()
for s in "${SCRIPTS[@]}"; do
    if (( ${#WANT[@]} == 0 )); then
        RUN+=("$s")
    else
        for w in "${WANT[@]}"; do
            [[ "$(name_of "$s")" == "$w" ]] && RUN+=("$s")
        done
    fi
done

if (( DRY_RUN )); then
    esp_open ro
else
    esp_open rw
fi

export ESP_MNT="$MNT"

FAILED=()

for s in "${RUN[@]}"; do
    n="$(name_of "$s")"

    log_info orchestrator "starting component: $n"

    if ! "$s"; then
        log_err orchestrator "component failed: $n"
        FAILED+=("$n")
    fi
done

sync

if (( ${#FAILED[@]} > 0 )); then
    log_err orchestrator "failed components: ${FAILED[*]}"
    exit 1
fi

if (( DRY_RUN )); then
    log_info orchestrator "dry-run completed"
else
    log_info orchestrator "synchronization completed"
fi
