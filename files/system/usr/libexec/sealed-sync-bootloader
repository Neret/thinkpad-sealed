#!/usr/bin/bash
# Copia il systemd-boot firmato dell'immagine sulla ESP (EFI/systemd e EFI/BOOT/grubx64.efi,
# che e' quello che carica shim). Verifica della firma con MOK.crt OBBLIGATORIA.
# Va in: files/system/usr/libexec/sealed-sync-bootloader (eseguibile)
set -euo pipefail
source "${SEALED_LIB:-/usr/libexec/sealed-sync-lib}"

SRC=/usr/lib/systemd/boot/efi/systemd-bootx64.efi

[[ -s "$SRC" ]]  || die "sorgente mancante: $SRC"
[[ -s "$CERT" ]] || die "certificato $CERT mancante: non tocco la ESP"
need_sbverify
sbverify --cert "$CERT" "$SRC" >/dev/null 2>&1 \
  || die "firma di $SRC NON valida con $CERT: non tocco la ESP"
echo "firma valida: $SRC"

esp_open
sync_file "$SRC" "$MNT/EFI/systemd/systemd-bootx64.efi"
sync_file "$SRC" "$MNT/EFI/BOOT/grubx64.efi"
sync
