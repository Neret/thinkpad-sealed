#!/bin/bash
set -euo pipefail

DISK="${1:-}"
[ -n "$DISK" ] || { echo "uso: install-sealed-os /dev/sdX"; exit 1; }

IMAGE_FILE="/SEALED_IMAGE"
[ -f "$IMAGE_FILE" ] || { echo "manca $IMAGE_FILE"; exit 1; }
IMAGE="$(cat "$IMAGE_FILE")"

echo ">> Installazione di ${IMAGE} su ${DISK}"

# 1. Installazione della rootfs sealed
bootc install to-disk \
  --via-loopback \
  --composefs-backend \
  --bootloader systemd \
  --filesystem btrfs \
  "$DISK"

# 2. Individua l'ESP (FAT32) e copia shim + MokManager + MOK
ESP="$(lsblk -no PATH,FSTYPE "$DISK" | awk '$2=="vfat"{print $1; exit}')"
[ -n "$ESP" ] || { echo "ESP non trovata"; exit 1; }

mkdir -p /mnt/esp
mount "$ESP" /mnt/esp

mkdir -p /mnt/esp/EFI/BOOT /mnt/esp/EFI/systemd

# shim (Microsoft-signed) e MokManager
SHIM="$(find /usr/share/efi /boot/efi -name 'shimx64.efi' 2>/dev/null | head -n1)"
MM="$(find /usr/share/efi /boot/efi -name 'mmx64.efi' 2>/dev/null | head -n1)"
[ -n "$SHIM" ] && [ -n "$MM" ] || { echo "shim/mmx64 non trovati"; umount /mnt/esp; exit 1; }

cp "$SHIM" /mnt/esp/EFI/BOOT/BOOTX64.EFI
cp "$MM"   /mnt/esp/EFI/BOOT/mmx64.efi

# MOK (DER) per l'enrollment al primo boot
cp /usr/local/share/mok/MOK.cer /mnt/esp/EFI/BOOT/MOK.der

umount /mnt/esp

echo ">> Installazione completata. Al primo boot, MokManager chiederà di enrollare il MOK."
