# syntax=docker/dockerfile:1
ARG UNSEALED=ghcr.io/neret/fedora-bootc-sealed-os:unsealed-latest
ARG TOOLS=quay.io/fedora/fedora:45

FROM ${UNSEALED} AS base

# Stage rootfs: kargs + split kernel/initramfs.
# Il digest composefs sarà calcolato su QUESTO rootfs,
# che è anche la base della final image: le viste coincidono.
FROM base AS split
ARG LUKS_UUID=9c879ac9-f3ad-49d9-bd94-1e98e3096f22
ARG ROOT_UUID=aecc2955-bf15-4741-9b75-ddc0d7184bdb
ARG KARGS_EXTRA=""

RUN set -euo pipefail; \
    mkdir -p /usr/lib/bootc/kargs.d; \
    cat > /usr/lib/bootc/kargs.d/10-sealed.conf <<KARGS
rd.luks.uuid=luks-${LUKS_UUID}
rd.luks.options=tpm2-device=auto
root=UUID=${ROOT_UUID}
vconsole.keymap=it
rw
rhgb
quiet
amd_iommu=on
iommu=pt
mitigations=auto
zswap.enabled=0
${KARGS_EXTRA}
KARGS

# Sposta vmlinuz/initramfs in /kernel/<kver>/ e li rimuove dal rootfs:
# finiranno embedded nella UKI.
RUN mkdir /kernel && \
    bootc container split-kernel-and-rootfs --rootfs / --output /kernel

# UKI firmata usando il bootc della BASE image:
# generatore e verificatore del digest usano la stessa versione
# di bootc/composefs-rs, eliminando il mismatch di formato.
FROM base AS sealed-uki
RUN dnf install -y systemd-ukify sbsigntools && dnf clean all

RUN --mount=type=bind,from=split,target=/target \
    --mount=type=bind,from=split,source=/kernel,target=/kernel \
    --mount=type=secret,id=key \
    --mount=type=secret,id=cert <<'EOF'
set -euo pipefail

kver=$(ls /kernel)
test -f "/kernel/${kver}/vmlinuz"
test -f "/kernel/${kver}/initramfs.img"

mkdir -p /out
bootc container ukify \
  --rootfs /target \
  --kernel-dir "/kernel/${kver}" \
  -- \
  --output "/out/${kver}.efi" \
  --signtool sbsign \
  --secureboot-private-key /run/secrets/key \
  --secureboot-certificate /run/secrets/cert
EOF

# Final image: rootfs già splittato + UKI firmata + systemd-boot firmato.
FROM split AS final
COPY --from=sealed-uki /out/*.efi /boot/EFI/Linux/

RUN set -euo pipefail; \
    rm -rf /kernel; \
    mkdir -p /boot/EFI/BOOT /boot/EFI/systemd; \
    cp /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/BOOT/BOOTX64.EFI; \
    cp /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/systemd/systemd-bootx64.efi; \
    bootc container lint --fatal-warnings

LABEL containers.bootc=sealed
