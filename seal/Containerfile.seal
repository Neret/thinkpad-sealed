# syntax=docker/dockerfile:1
ARG BASE=ghcr.io/neret/fedora-bootc-sealed-os:latest
ARG LUKS_UUID=9c879ac9-f3ad-49d9-bd94-1e98e3096f22
ARG ROOT_UUID=aecc2955-bf15-4741-9b75-ddc0d7184bdb
# Lista pacchetti generata dalla CI da recipes/packages.yml
ARG PACKAGES=""

# --- 1. Base: immagine BlueBuild, fonte di repos e package set ---
FROM ${BASE} AS target-base

# --- 2. Rootfs composefs-native, ricostruito from scratch ---
# Usa i repo della base come sorgente; il manifest di default
# produce un rootfs fedora-bootc pulito, senza /sysroot/ostree.
FROM target-base AS build-rootfs
RUN /usr/libexec/bootc-base-imagectl build-rootfs / /target-rootfs

# Installa i pacchetti della recipe nel rootfs ricostruito,
# usando dnf della base e i suoi repo.
RUN --mount=type=bind,from=target-base,target=/run/base \
    /run/base/usr/bin/dnf -y \
      --installroot=/target-rootfs \
      --releasever=45 \
      --setopt=reposdir=/run/base/etc/yum.repos.d \
      --setopt=module_platform_id=platform:f45 \
      install \
      ${PACKAGES}

# Pulizia cache e metadati dnf nel rootfs
RUN rm -rf /target-rootfs/var/cache/dnf \
           /target-rootfs/var/log/dnf.* \
           /target-rootfs/var/lib/dnf

# Ri-applica le customizzazioni sul rootfs ricostruito
COPY files/system/ /target-rootfs/
COPY files/gschema-overrides/zz0-thinkpad.gschema.override \
     /target-rootfs/usr/share/glib-2.0/schemas/
COPY files/scripts/assets.sh /target-rootfs/tmp/assets.sh

RUN set -euo pipefail; \
    chroot /target-rootfs /tmp/assets.sh; \
    rm -f /target-rootfs/tmp/assets.sh; \
    chroot /target-rootfs glib-compile-schemas /usr/share/glib-2.0/schemas; \
    systemctl --root=/target-rootfs enable \
      gdm.service \
      NetworkManager.service \
      systemd-resolved.service \
      bluetooth.service \
      firewalld.service; \
    systemctl --root=/target-rootfs disable irqbalance.service || true; \
    ln -sf /usr/lib/systemd/system/graphical.target \
      /target-rootfs/etc/systemd/system/default.target

# --- 3. Rootfs finale: albero pulito, base del digest ---
FROM scratch AS rootfs
COPY --from=build-rootfs /target-rootfs /

# --- 4. UKI firmata + systemd-boot firmato ---
# Usa il bootc DEL ROOTFS TARGET: generatore e verificatore
# del digest condividono la stessa versione di bootc/composefs-rs.
FROM target-base AS sealer
RUN dnf install -y systemd-ukify sbsigntools && dnf clean all

RUN --mount=type=bind,from=rootfs,target=/target \
    --mount=type=secret,id=key \
    --mount=type=secret,id=cert <<'EOF'
set -euo pipefail

kver=$(ls /target/usr/lib/modules)
test -f "/target/usr/lib/modules/${kver}/vmlinuz"
test -f "/target/usr/lib/modules/${kver}/initramfs.img"

mkdir -p /out/boot/EFI/Linux /out/boot/EFI/BOOT /out/boot/EFI/systemd

/target/usr/bin/bootc container ukify \
  --rootfs /target \
  --karg "rd.luks.uuid=luks-${LUKS_UUID}" \
  --karg "rd.luks.options=tpm2-device=auto" \
  --karg "root=UUID=${ROOT_UUID}" \
  --karg "vconsole.keymap=it" \
  --karg "rw" \
  --karg "rhgb" \
  --karg "quiet" \
  --karg "amd_iommu=on" \
  --karg "iommu=pt" \
  --karg "mitigations=auto" \
  --karg "zswap.enabled=0" \
  -- \
  --output "/out/boot/EFI/Linux/${kver}.efi" \
  --signtool sbsign \
  --secureboot-private-key /run/secrets/key \
  --secureboot-certificate /run/secrets/cert

sbsign --key /run/secrets/key --cert /run/secrets/cert \
  --output /out/boot/EFI/BOOT/BOOTX64.EFI \
  /target/usr/lib/systemd/boot/efi/systemd-bootx64.efi

sbsign --key /run/secrets/key --cert /run/secrets/cert \
  --output /out/boot/EFI/systemd/systemd-bootx64.efi \
  /target/usr/lib/systemd/boot/efi/systemd-bootx64.efi
EOF

# --- 5. Final: rootfs intatto + solo /boot aggiunto ---
# Nessuna modifica al rootfs dopo il calcolo del digest.
FROM rootfs AS final
COPY --from=sealer /out/boot/ /boot/

RUN bootc container lint --fatal-warnings

LABEL containers.bootc=sealed
