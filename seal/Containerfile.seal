# syntax=docker/dockerfile:1
ARG UNSEALED=ghcr.io/neret/fedora-bootc-sealed-os:unsealed-latest
ARG TOOLS=quay.io/fedora/fedora:45

FROM ${UNSEALED} AS base

# Rootfs senza kernel/initramfs grezzi: su questo viene calcolato il digest.
FROM base AS slim
RUN set -euo pipefail; \
    kver="$(cd /usr/lib/modules && echo *)"; \
    test -d "/usr/lib/modules/${kver}"; \
    rm -f "/usr/lib/modules/${kver}/vmlinuz" "/usr/lib/modules/${kver}/initramfs.img"

FROM ${TOOLS} AS buildroot
RUN dnf install -y \
      bootc \
      systemd-ukify \
      systemd-udev \
      sbsigntools \
      openssl \
      systemd-boot-unsigned \
    && dnf clean all

# UKI firmata: il digest composefs è calcolato da bootc container ukify
# direttamente sul rootfs /target, non dallo storage.
FROM buildroot AS sealed-uki
ARG LUKS_UUID=9c879ac9-f3ad-49d9-bd94-1e98e3096f22
ARG ROOT_UUID=aecc2955-bf15-4741-9b75-ddc0d7184bdb
ARG KARGS_EXTRA=""

# Copia il rootfs in una directory scrivibile: il mount bind da stage è read-only.
COPY --from=slim / /target

RUN --mount=type=secret,id=key \
    --mount=type=secret,id=cert \
    --mount=type=bind,from=base,target=/kernel-src <<'EOF'
set -euo pipefail

kver=$(find /kernel-src/usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -V | tail -n1)
test -n "${kver}"
test -f "/kernel-src/usr/lib/modules/${kver}/vmlinuz"
test -f "/kernel-src/usr/lib/modules/${kver}/initramfs.img"

mkdir -p /target/usr/lib/bootc/kargs.d
cat > /target/usr/lib/bootc/kargs.d/10-sealed.conf <<KARGS
rd.luks.uuid=luks-${LUKS_UUID}
rd.luks.options=tpm2-device=auto
root=UUID=${ROOT_UUID}
vconsole.keymap=it
rw
rhgb
quiet
amd_iommu=on
iommu=pt
mitigations=auto
zswap.enabled=0
${KARGS_EXTRA}
KARGS

mkdir -p /out
bootc container ukify \
  --rootfs /target \
  --kernel-dir "/kernel-src/usr/lib/modules/${kver}" \
  -- \
  --output "/out/${kver}.efi" \
  --signtool sbsign \
  --secureboot-private-key /run/secrets/key \
  --secureboot-certificate /run/secrets/cert
EOF

# Immagine finale: rootfs slim + UKI firmata + systemd-boot firmato nei path ESP.
FROM slim AS final
COPY --from=sealed-uki /out/*.efi /boot/EFI/Linux/

RUN set -euo pipefail; \
    mkdir -p /boot/EFI/BOOT /boot/EFI/systemd; \
    cp /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/BOOT/BOOTX64.EFI; \
    cp /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/systemd/systemd-bootx64.efi; \
    bootc container lint --fatal-warnings

LABEL containers.bootc=sealed
